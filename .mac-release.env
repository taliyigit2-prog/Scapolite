# Signed/notarized releases are disabled until Scapolite has its own Developer ID
# certificate and Sparkle key. Local packages remain ad-hoc signed with no feed.
MAC_RELEASE_APP_NAME=Scapolite
MAC_RELEASE_REPO=taliyigit2-prog/Scapolite
MAC_RELEASE_BUNDLE_ID=com.taliyigit2.scapolite
MAC_RELEASE_VERSION_FILE=version.env
MAC_RELEASE_APPCAST=appcast.xml
MAC_RELEASE_SOURCE_FILES='Scripts/release_artifacts.sh'
MAC_RELEASE_APP_ZIP='$(codexbar_app_zip_name "$MARKETING_VERSION" "${ARCHES:-arm64 x86_64}")'
MAC_RELEASE_DSYM_ZIP='$(codexbar_dsym_zip_name "$MARKETING_VERSION" "${ARCHES:-arm64 x86_64}")'
MAC_RELEASE_ARTIFACT_PREFIX='Scapolite-macos-[A-Za-z0-9_+-]+-'
MAC_RELEASE_FEED_URL=''
MAC_RELEASE_DOWNLOAD_URL_PREFIX='https://github.com/taliyigit2-prog/Scapolite/releases/download/v${MARKETING_VERSION}/'

MAC_RELEASE_PRECHECK='make check && make test'
MAC_RELEASE_PACKAGE_CMD='Scripts/sign-and-notarize.sh'
MAC_RELEASE_GENERATE_APPCAST_ARGS='--maximum-deltas 0'
